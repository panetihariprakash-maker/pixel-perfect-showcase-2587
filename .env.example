# Public project configuration only. Copy the values supplied by your hosting.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server settings: configure through the secure secret store, not a committed file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Privileged database credentials are hosting-managed on Lovable Cloud.
# Never add private credentials to VITE_* or commit secret-bearing .env files.